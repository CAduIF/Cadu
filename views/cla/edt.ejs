<%-include('../cabecalho.ejs')%>
 <header>
        <h3>Editar Clã</h3>
      </header>
      <div class="content">
        <form id="form-cla" method="post" autocomplete="off" >
          <div class="grid">
            <div>
              <label for="nome">Nome do Clã</label>
              <input id="nome" value="<%=cla.nome%>" name="nome" type="text" placeholder="Ex: Uchiha" required>
            </div>
            <div>
              <label for="fundador">Fundador</label>
              <input id="fundador" value="<%=cla.fundador%>" name="fundador" type="text" placeholder="Ex: Indra Otsutsuki" required>
            </div>
            <div>
              <label for="localidade">Localidade</label>
              <input id="localidade" value="<%=cla.localidade%>" name="localidade" type="text" placeholder="Ex: Konoha" required>
            </div>
            <div>
              <label for="kekkeigenkai">kekkeigenkai</label>
              <input id="kekkeigenkai" value="<%=cla.kekkeigenkai%>" name="kekkeigenkai" type="text" placeholder="Ex: Sharingan" required>
            </div>
              
           <div class="field-help">Os campos com * são obrigatórios.</div>
          <footer>
            <a type="button" class="btn ghost" id="btn-cancelar" href="/cla/lst">Cancelar</a>
            <button type="submit" class="btn primary">Editar Clã</button>
          </footer>
        </form>
      </div>

  <%-include('../rodape.ejs')%>